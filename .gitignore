# HuggingFace model cache (multi-GB; never commit)
.cache/
# Anchored to the repo root and to ml/ specifically. A bare `models/` matches
# ANY directory of that name at any depth, which silently excluded
# src/lib/models/trained_skynet_nlp.json -- a file three source modules import
# statically. `git add -A` skipped it without a word and main shipped unable to
# compile. Keep these patterns anchored.
/models/
ml/models/

# Agent configuration (may contain API keys)
.agents/
