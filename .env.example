# ─────────────────────────────────────────────────────────────────────
# SIH26-26152 — environment template. Copy to .env and fill in.
# .env is gitignored; never commit real values.
# ─────────────────────────────────────────────────────────────────────

# MongoDB Atlas. The database name comes from the URI path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sih26152?retryWrites=true&w=majority
# Optional override if you need a database other than the one in the URI.
# MONGODB_DB=sih26152

# NextAuth. REQUIRED — the app refuses to start without it, and it must be
# at least 32 characters. There is deliberately no fallback default: a
# committed fallback lets anyone with the repo forge a valid session.
#   Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional — credentials login works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── ML service ───────────────────────────────────────────────────────
# The Python transformer service in ml/. Runs separately; it cannot be
# hosted on Vercel. Leave as-is for local development.
ML_API_URL=http://127.0.0.1:8000
# Generous: the first batch after ML startup costs ~21s (lazy topic-model fit).
ML_TIMEOUT_MS=60000
# Items per request. Steady-state CPU throughput is ~8 items/s.
ML_CHUNK_SIZE=40
# Set to "false" to force the lexicon fallback and skip the ML service.
ML_ENABLED=true

# ── Platform ingestion ───────────────────────────────────────────────
# All six platforms from the problem statement have working connectors.
# Each starts returning data as soon as its credentials are present; none
# is simulated. Check live status at /api/platforms.
# Full walkthrough for every platform: docs/platform-setup.md

# --- ESSENTIAL (Must-Have) ---

# X (Twitter). The ONLY platform that costs money: reading tweets requires
# at least the Basic tier (~$100/mo). Every unauthenticated route was
# verified closed on 2026-08-25. Free tier can post but not read.
X_BEARER_TOKEN=

# Telegram. Works with NO credentials for public channels via the t.me
# preview — this is the zero-setup demo path.
# Optional: a bot token also reads chats the bot has been added to.
TELEGRAM_BOT_TOKEN=
# MTProto full-history access needs a session string minted by an
# interactive local login — see docs/telegram-setup.md
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# --- DESIRABLE (Good-to-Have) ---

# Instagram Graph API. Free, but needs an Instagram Business/Creator
# account linked to a Facebook Page. Long-lived tokens expire after 60 days.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# Facebook Graph API. Free for Pages the token administers. Reading
# arbitrary third-party Pages needs Meta App Review.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# --- APPRECIABLE ADDITIONS ---

# Reddit. The public JSON gateway now returns 403 (verified 2026-08-25),
# so OAuth is required. Registering a free "script" app takes ~2 minutes.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SIH26152-AudienceIntelligence/1.0

# YouTube Data API v3. Free key, 10,000 quota units/day.
YOUTUBE_API_KEY=

# Pin the synthetic demo dataset to a fixed date so screenshots stay stable.
# DEMO_DATE=2026-08-25
