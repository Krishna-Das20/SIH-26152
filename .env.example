# ─────────────────────────────────────────────────────────────────────
# SIH26-26152 — environment template. Copy to .env and fill in.
# .env is gitignored; never commit real values.
# ─────────────────────────────────────────────────────────────────────

# MongoDB Atlas. The database name comes from the URI path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sih26152?retryWrites=true&w=majority
# Optional override if you need a database other than the one in the URI.
# MONGODB_DB=sih26152

# NextAuth. REQUIRED — the app refuses to start without it, and it must be
# at least 32 characters. There is deliberately no fallback default: a
# committed fallback lets anyone with the repo forge a valid session.
#   Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional — credentials login works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── ML service ───────────────────────────────────────────────────────
# The Python transformer service in ml/. Runs separately; it cannot be
# hosted on Vercel. Leave as-is for local development.
ML_API_URL=http://127.0.0.1:8000
# Generous: the first batch after ML startup costs ~21s (lazy topic-model fit).
ML_TIMEOUT_MS=60000
# Items per request. Steady-state CPU throughput is ~8 items/s.
ML_CHUNK_SIZE=40
# Set to "false" to force the lexicon fallback and skip the ML service.
ML_ENABLED=true

# ── Platform ingestion ───────────────────────────────────────────────
# Telegram (Essential platform).
#   - Public channels work with NO credentials via the t.me web preview.
#   - A bot token additionally reads channels the bot has been added to.
TELEGRAM_BOT_TOKEN=
# MTProto full-history access. Requires a one-time interactive login to mint
# a session string — see docs/telegram-setup.md. Not yet wired in.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Reddit — the public JSON gateway needs no key; these are optional.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SIH2026_Monitor:v1.0

# YouTube Data API v3 (optional; comment ingestion is skipped without it)
YOUTUBE_API_KEY=

# Pin the synthetic demo dataset to a fixed date so screenshots stay stable.
# DEMO_DATE=2026-08-25
