# SIH26-26152 Environment Configuration Example

# MongoDB Atlas URI (Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URI=

# Telegram Credentials (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=

# Reddit API (Optional - Native public stream enabled by default)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SIH2026_Monitor:v1.0

# Twitter / X (Optional)
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
